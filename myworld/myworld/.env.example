# Copy this file to `.env` in the same folder (myworld/myworld/.env) and adjust
# it. The real `.env` is git-ignored - never commit it.

# True for local development, False in production.
DEBUG=True

# Required when DEBUG=False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me-to-a-long-random-string

# Production only (comma separated):
# ALLOWED_HOSTS=example.com,www.example.com
# CSRF_TRUSTED_ORIGINS=https://example.com

# Database. Without any DB_* variable a local SQLite file (myworld/db.sqlite3)
# is used. For PostgreSQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=your_database_name
# DB_USER=your_database_user
# DB_PASSWORD=your_database_password
# DB_HOST=localhost
# DB_PORT=5432
